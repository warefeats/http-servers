# The build (src/build.ts) writes one project per candidate from this template, filling the marker
# lines below: the axum dependency (an exact crates.io version, or a git commit, whose workspace
# supplies axum-core from the same commit); axum needs no [patch] table.
[package]
name = "bench-axum"
version = "0.0.0"
edition = "2021"
publish = false

[dependencies]
@FRAMEWORK@
bench-common = { path = "@COMMON@" }
tokio = { version = "1", features = ["macros", "rt-multi-thread", "net"] }
# the file server axum's docs use
tower-http = { version = "0.6", features = ["fs"] }

[workspace]

@PATCH@
